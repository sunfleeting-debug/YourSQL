# YourSQL 后端配置模板
# 复制为 .env 后按本机环境修改。敏感值不要提交；系统环境变量优先于此文件。

# Web 服务
YOURSQL_DATABASE=data/workbench.db
YOURSQL_HOST=127.0.0.1
YOURSQL_PORT=8080
# 多个 Origin 使用英文逗号分隔；同源访问可留空。
YOURSQL_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
# 仅旧教学客户端需要；生产/工作台保持 false。
YOURSQL_LEGACY_ANONYMOUS=false

# 工作台会话、请求与查询边界
YOURSQL_SESSION_TTL_SECONDS=3600
YOURSQL_REQUEST_TIMEOUT_SECONDS=10
YOURSQL_QUERY_TIMEOUT_SECONDS=15
YOURSQL_MAX_QUERY_TIMEOUT_SECONDS=30
YOURSQL_DEFAULT_RESULT_ROWS=1000
YOURSQL_MAX_RESULT_ROWS=5000
YOURSQL_MAX_REQUEST_BODY_BYTES=262144
YOURSQL_MAX_SQL_CHARS=64000
YOURSQL_MAX_STATEMENTS=32
YOURSQL_MAX_SESSIONS=64
YOURSQL_MAX_TASKS=32
YOURSQL_HISTORY_ENTRIES=200
YOURSQL_RESULT_RETENTION_BYTES=2000000
# 查询总耗时达到该值时记为慢查询，并追加性能摘要日志。
YOURSQL_SLOW_QUERY_MS=500
# 普通查询保留完整 Trace/执行计划的抽样比例；慢查询和异常资源消耗会自动保留。
YOURSQL_MONITOR_DIAGNOSTIC_SAMPLE_RATE=0.01
# 留空表示关闭流水线步数硬上限；超时和取消仍然生效。
YOURSQL_TRACE_MAX_STEPS=

# 存储引擎默认参数；打开已有数据库时页大小仍以数据库自身格式为准。
YOURSQL_PAGE_SIZE=4096
YOURSQL_BUFFER_POOL_SIZE=64
YOURSQL_REPLACEMENT_POLICY=lru
# 可选：保护 INDEX/CATALOG/SUPERBLOCK 页，优先淘汰 HEAP 页。
YOURSQL_BUFFER_POOL_PROTECT_PAGE_TYPES=false
YOURSQL_MAX_VARCHAR_LENGTH=1000000

# CLI/SSH 默认登录信息。生产环境请使用系统环境变量或命令行覆盖密码。
YOURSQL_CLI_DATABASE=data/workbench.db
YOURSQL_CLI_USER=admin
YOURSQL_CLI_PASSWORD=admin
